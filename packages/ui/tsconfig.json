{
  "extends": "@cms/tsconfig/react.json",
  "compilerOptions": {
    "types": ["vitest/globals", "@testing-library/jest-dom/vitest"],
    "paths": {
      "@cms/ui": ["./src/index.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    ".cache",
    ".turbo",
    "src/**/*.stories.tsx",
    "src/**/*.stories.ts"
  ]
}
