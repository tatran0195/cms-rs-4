{
  "name": "cms",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev:studio": "turbo run dev --filter=@cms/studio",
    "dev:storybook": "turbo run dev --filter=@cms/storybook",
    "build:storybook": "pnpm --filter @cms/storybook build-storybook",
    "dev:mobile": "turbo run start --filter=@cms/mobile",
    "dev:tv": "turbo run start --filter=@cms/tv",
    "build": "turbo run build",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "lint": "ultracite check",
    "format": "biome check --write --unsafe --max-diagnostics=none .",
    "knip": "knip",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"!**/node_modules/**\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\" \"!**/node_modules/**\"",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "devDependencies": {
    "turbo": "^2.11.7",
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.63.0",
    "knip": "^6.39.0",
    "react-doctor": "^0.9.17",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "markdownlint-cli2": "^0.23.3",
    "ultracite": "^7.12.4",
    "unrun": "^0.3.1"
  }
}
