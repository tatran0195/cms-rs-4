{
  "name": "cms",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "ultracite check",
    "dev:storybook": "bun --filter @cms/ui storybook",
    "dev:studio": "bun --filter @cms/studio dev",
    "dev:ui": "bun --filter @cms/ui dev",
    "dev:web": "bun --filter @cms/web dev",
    "fix": "ultracite fix",
    "format": "biome check --write --unsafe --max-diagnostics=none .",
    "knip": "knip",
    "lint": "ultracite check",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"!**/node_modules/**\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\" \"!**/node_modules/**\"",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.63.0",
    "knip": "^6.39.0",
    "markdownlint-cli2": "^0.23.3",
    "react-doctor": "^0.9.17",
    "tsdown": "^0.23.0",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2",
    "ultracite": "^7.12.4",
    "unrun": "^0.3.1"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=24.0.0"
  },
  "catalog": {
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "esbuild",
    "msw"
  ]
}
